{
  // Self-hosted global config (repositories/platform/onboarding), separate
  // from renovate.json5 (repo-level rules) at the repo root.
  platform: 'github',
  repositories: ['lootem/devcontainer'],
  onboarding: false,
  requireConfig: 'optional',
  // Permit only the fixed Kiro lock refresher. No shell metacharacters,
  // alternate dependencies, prereleases, or arbitrary executors are allowed.
  allowedCommands: [
    '^\\./install\\.sh dependency-lock kiro [0-9]+\\.[0-9]+\\.[0-9]+$',
  ],
}
