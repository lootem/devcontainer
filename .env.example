# Copy this file to .env and uncomment the matching mappings in
# .devcontainer/docker-compose.yml. Compose passes only variables mapped there;
# it does not inject this file wholesale.

# -- Anthropic API --------------------------------------------------------------
ANTHROPIC_API_KEY=

# -- AWS Bedrock ---------------------------------------------------------------
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -- Azure AI Foundry ----------------------------------------------------------
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=

# -- OpenAI API ---------------------------------------------------------------
OPENAI_API_KEY=

# -- Azure OpenAI -------------------------------------------------------------
# For Codex, also replace YOUR_RESOURCE_NAME in the generated Azure provider in
# .codex/config.toml, adjust its api-version there if needed, and select it with
# top-level model_provider/model settings.
# OpenCode needs AZURE_RESOURCE_NAME and can retain its key through /connect.
AZURE_OPENAI_API_KEY=
AZURE_RESOURCE_NAME=

# -- Kiro CLI headless authentication -----------------------------------------
# Optional: interactive browser authentication is stored under .kiro instead.
KIRO_API_KEY=
